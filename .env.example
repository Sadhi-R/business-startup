# Public site URL used for canonical links, Open Graph, sitemap, and robots.
# Set this to the live domain before building for production. No trailing slash.
PUBLIC_SITE_URL=https://your-business-startup-school-domain.example

# Mail driver: "smtp" sends mail. "log" writes storage/mail.log and does not send.
# Leave MAIL_DRIVER unset in production and set the SMTP values below.
# Do not use "log" on a public server.
MAIL_DRIVER=

# Verified mailbox that the SMTP provider allows as the From address.
SMTP_FROM="Business Startup School <10xwealthcreators@gmail.com>"

# Inbox that receives enquiries.
CONTACT_TO=10xwealthcreators@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=10xwealthcreators@gmail.com
SMTP_PASS=replace-with-an-app-password
